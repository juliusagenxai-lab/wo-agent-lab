# ── LLM provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to choose the backend:
#   "gemini"  → Google Gemini via langchain-google-genai (recommended)
#   "openai"  → OpenAI or any OpenAI-compatible endpoint (Ollama, etc.)
LLM_PROVIDER=gemini

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Obtain your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Gemini model name — gemini-3.8-flash is the current recommended default;
# use gemini-2.5-pro for highest accuracy on scoring tasks (Pro+ recommended)
LLM_MODEL=gemini-3.8-flash

# ── OpenAI-compatible fallback ────────────────────────────────────────────────
# Only used when LLM_PROVIDER=openai
# For a local Ollama model: http://localhost:11434/v1
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# ── Embeddings ────────────────────────────────────────────────────────────────
# sentence-transformers model name (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ──────────────────────────────────────────────────────────────
# Directory where Chroma persists its collections
CHROMA_PERSIST_DIR=.chroma
